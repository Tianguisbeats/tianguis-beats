                                    className={`relative shrink-0 snap-center px-6 md:px-10 py-3 md:py-4 text-[10px] md:text-[12px] font-black uppercase tracking-[0.2em] whitespace-nowrap transition-all group overflow-hidden ${activeTab === tab.id
