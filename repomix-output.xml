                                {/* Motivación Horizontal */}
                                <div className="p-6 bg-foreground/5 rounded-3xl border border-border flex flex-col gap-3">
                                    <p className="text-[9px] font-black uppercase text-muted tracking-[0.2em]">Motivación del Artista</p>
