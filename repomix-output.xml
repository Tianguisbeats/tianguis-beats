                                    <motion.div animate={{ rotate: [0, 5, 0], x: [0, 8, 0] }} transition={{ duration: 10, repeat: Infinity }} className="absolute -top-4 -right-4 w-24 h-24 border-2 border-blue-500/20 rounded-3xl z-[-1]" />
