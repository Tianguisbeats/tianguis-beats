# ==============================================================================
# TIANGUIS BEATS — Variables de Entorno
# ==============================================================================
# Copia este archivo a .env.local y completa los valores.
# NUNCA commitear .env o .env.local.
# ==============================================================================

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJI..."
# Solo server-side. Bypassa RLS — cuidado.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJI..."

# --- URL Pública -------------------------------------------------------------
NEXT_PUBLIC_URL="https://tianguisbeats.com"

# --- Stripe (6 variables) ----------------------------------------------------
# Las 4 vars de PRICE corresponden 1-a-1 con tus 4 planes de suscripción.
# Las llaves SECRET y WEBHOOK son las del dashboard de Stripe.
#
# 🟢 PARA TENER TEST/LIVE SIN TOCAR CÓDIGO:
#    En Vercel → Settings → Environment Variables, configura cada una de
#    las 6 vars con valor distinto según el environment:
#
#       Production    → valores LIVE  (sk_live_..., price_LIVE_...)
#       Preview       → valores TEST  (sk_test_..., price_TEST_...)
#       Development   → valores TEST  (sk_test_..., price_TEST_...)
#
#    Resultado: tu dominio principal cobra real, los preview/branches y tu
#    localhost siempre están en Test. Cero switches manuales, cero pausas
#    de pagos en producción.

STRIPE_SECRET_KEY="sk_live_...   # o sk_test_... en Preview/Development"
STRIPE_WEBHOOK_SECRET="whsec_... # un endpoint distinto por modo en Stripe"

# Los 4 priceIds (uno por plan + ciclo). Cambian entre Test y Live.
STRIPE_PRICE_PRO_MENSUAL="price_..."
STRIPE_PRICE_PRO_ANUAL="price_..."
STRIPE_PRICE_PREMIUM_MENSUAL="price_..."
STRIPE_PRICE_PREMIUM_ANUAL="price_..."

# --- Vercel (auto-rellenado) -------------------------------------------------
# VERCEL_URL=
